{
  "name": "central-brownies-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware . && bun run typecheck",
    "lint:fix": "oxlint --type-aware --fix .",
    "typecheck": "next typegen && ./node_modules/typescript-7/bin/tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint:fix && bun run format && bun run typecheck",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/seed.ts",
    "admin:create": "bun scripts/admin-create.ts",
    "vercel-build": "drizzle-kit migrate && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^10.5.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.555.0",
    "next": "16.4.6",
    "passkit-generator": "^3.5.5",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.1.17",
    "typescript": "^5",
    "typescript-7": "npm:typescript@7",
    "vitest": "^4.0.15"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
