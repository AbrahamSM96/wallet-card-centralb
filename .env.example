# =============================================================================
# Plantilla de entorno para Central Brownies.
#
#   cp .env.example .env.local
#
# Nunca subas `.env` ni `.env.local`. En producción configura estos valores en
# Vercel. La marca y los textos públicos viven en código o en la tabla settings.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# En producción usa la URL SSL de Neon. La aplicación acepta la URL con pooler;
# Drizzle Kit la convierte a conexión directa al ejecutar migraciones.
DATABASE_URL=

# Desarrollo local con `bun run db:up`:
# DATABASE_URL=postgres://central_brownies:central_brownies@localhost:5434/central_brownies

# Credenciales consumidas únicamente por Docker Compose.
POSTGRES_USER=central_brownies
POSTGRES_PASSWORD=central_brownies
POSTGRES_DB=central_brownies
POSTGRES_PORT=5434

# --- Sesiones del panel ------------------------------------------------------
# Secreto de al menos 32 caracteres para firmar la cookie del admin.
# Genera uno con: openssl rand -base64 32
SESSION_SECRET=

# --- Aplicación --------------------------------------------------------------
# URL pública sin slash final. Se usa para construir links de reclamo y
# mensajes de WhatsApp. En local:
# APP_URL=http://localhost:3000
APP_URL=

# --- Google Wallet (opcional) -----------------------------------------------
# Si faltan estas variables, el panel y el resto de la app siguen funcionando;
# solo la emisión de Google Wallet devuelve un error de configuración claro.
# El JSON es la llave completa de una service account codificada en base64.
GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=central_brownies_loyalty
# URL HTTPS pública que Google pueda descargar. En local usa un túnel o CDN.
GOOGLE_WALLET_LOGO_URL=

# --- Apple Wallet (opcional) ------------------------------------------------
# Certificados, llaves y APNs se cargan solo al emitir o actualizar Apple.
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_BASE64=
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_APNS_KEY_ID=
APPLE_APNS_KEY_BASE64=

# --- Cron de cumpleaños ------------------------------------------------------
# Secreto de al menos 32 caracteres. Vercel lo envía como Bearer token.
CRON_SECRET=
